/* Simple binary math expressions */
// Minus == 1
2 - 1
// Plus == 3
1 + 2
// Multiply == 6
2 * 3
// Divide == 2
4 / 2
// Divide fractional == 2.5
5 / 2
// Divide by fractional == 2.666667
4 / 1.5
// Negative result == -1
1 - 2
// Negative operand == 1
-2 + 3
// Division by negative == -2
4 / -2
// Negative divided by positive == -2
-4 / 2

/* Precedence & perentheses */
// Multiplication before addition == 5
2 + 3 * 1
// Parentheses change precedence == 5
(2 + 3) * 1
// Nested parentheses == 14
(2 + (3 * 4))

/* Binary comparison expressions */
// Equal true
3 == 3
// Equal false
3 == 4
// Not equal true
3 != 4
// Greater true
4 > 3
// Greater false
3 > 4
// Less true
3 < 4
// Less false
4 < 3
// Greater or equal true
4 >= 4
// Less or equal true
3 <= 3

/* Mixed */
// 7 == 7 (true)
3 + 4 == 2 * 3 + 1
// 10 == 12 (false)
(2 + 3) * 2 == 12
